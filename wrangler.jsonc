{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framework-mcp-api",
  "main": "src/interfaces/worker/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Comma-separated list of allowed CORS origins ("*" to allow any).
    "ALLOWED_ORIGINS": "*"
  },
  // Cloudflare's native rate-limiting binding: 20 requests / 10s per client IP.
  //
  // Tightened from 100/60s because the binding is an approximate, per-location
  // counter rather than a hard quota, so it clips bursts but lets a paced
  // stream above the nominal limit through: measured against production,
  // 115 requests at ~5/s (300/min, 3x the then-limit) drew zero 429s, while
  // the same count at ~20/s was clipped. A 10s period catches paced traffic
  // far sooner. `period` accepts only 10 or 60.
  //
  // Mirrors RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS defaults from the Express server.
  "unsafe": {
    "bindings": [
      { "name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 20, "period": 10 } }
    ]
  }
  // Custom domain (optional): uncomment and set your zone's hostname.
  // "routes": [{ "pattern": "api.example.com", "custom_domain": true }]
}
